# --- Admin URL (same value for both — pick a long random segment, not "admin") ---
ADMIN_SECRET_PATH=
NEXT_PUBLIC_ADMIN_PATH=

# --- Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Firebase (Firestore + Auth) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: restrict admin to specific emails (comma-separated)
NEXT_PUBLIC_ADMIN_EMAILS=
